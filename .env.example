# Copy this file to .env and adjust values for your local environment (chmod 600 .env).
APP_ENV=development
DATABASE_PATH=data/margin_guard.sqlite3

# Create a bot with Telegram's BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token

# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Key rotation: pass comma-separated keys (NEW_KEY,OLD_KEY); new tokens use NEW_KEY.
TOKEN_ENCRYPTION_KEY=generate_with_cryptography_fernet

# Monitoring cadence in minutes (allowed range: 30..60).
MONITORING_INTERVAL_MINUTES=45

# Optional zero-trust allowlist of Telegram user IDs (comma-separated, e.g. 12345678,87654321).
# Leave empty to allow any private-chat user within rate limits.
ALLOWED_TELEGRAM_IDS=

# Wildberries HTTP client bounds.
WB_REQUEST_TIMEOUT_SECONDS=10
WB_MAX_RETRIES=3
MONITORING_MAX_CONCURRENCY=4
